generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  goals        Goal[]
  entries      FoodEntry[]
  weights      WeightLog[]
}

/// Goals are append-only rather than mutable: each row is the set of targets that
/// took effect on `effectiveFrom`. Historical reports can therefore compare a day
/// against the targets that were actually active on that day.
model Goal {
  id             String   @id @default(cuid())
  userId         String
  dailyCalories  Float
  proteinGrams   Float
  carbGrams      Float
  fatGrams       Float
  targetWeightKg Float?
  effectiveFrom  DateTime
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
}

/// One weigh-in per calendar day. Logging again on the same day replaces that
/// reading so the chart does not fork into two points for Tuesday.
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  kg        Float
  /// Midnight UTC key for the eater's calendar day, same convention as entries.
  loggedOn  DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loggedOn])
  @@index([userId, loggedOn])
}

model FoodEntry {
  id           String   @id @default(cuid())
  userId       String
  mealType     String
  foodName     String
  quantity     Float
  unit         String
  calories     Float
  proteinGrams Float    @default(0)
  carbGrams    Float    @default(0)
  fatGrams     Float    @default(0)

  /// Exact time the food was eaten, used for ordering within a day.
  consumedAt   DateTime
  /// Same instant truncated to midnight UTC. Denormalised so daily and weekly
  /// aggregates can be a plain indexed GROUP BY instead of a per-dialect date
  /// function, which also keeps the queries portable across databases.
  consumedOn   DateTime

  /// How the entry was created: manual | image | pdf | chat. Useful for the
  /// reports and for debugging AI-generated entries.
  source       String   @default("manual")

  /// Optional free text from the log-meal form. Not used in reports.
  notes        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  micronutrients NutrientAmount[]

  @@index([userId, consumedOn])
  @@index([userId, mealType])
}

/// Micronutrients are stored as rows rather than columns. The set of vitamins and
/// minerals an AI extraction or a PDF import might return is open-ended, so a
/// fixed column per nutrient would mean a migration every time a new one appears.
model NutrientAmount {
  id       String    @id @default(cuid())
  entryId  String
  /// Canonical key, e.g. "vitamin_c", "iron", "sodium".
  nutrient String
  amount   Float
  unit     String

  entry    FoodEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, nutrient])
  @@index([nutrient])
}
