# Neon Postgres. Pooled URL for queries, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

PORT=4000
NODE_ENV=development

# Local: http://localhost:3000
# Production: the Vercel origin, no trailing slash
CORS_ORIGIN="http://localhost:3000"

# openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Photo extract (Groq or OpenAI-compatible). Leave blank to disable.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_JSON_MODE="schema"
AI_CHAT_MODEL=""
AI_REASONING_EFFORT=""

# Chat and PDF Deep Analyse. Leave blank to disable.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
