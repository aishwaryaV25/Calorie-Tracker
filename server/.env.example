# Neon Postgres. Prisma uses DATABASE_URL for queries (pooled) and DIRECT_URL
# for migrations (direct). Copy both from Neon → Dashboard → Connection details.
#
#   DATABASE_URL  → pooled  (host contains "-pooler")
#   DIRECT_URL    → direct  (host has no "-pooler")
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
# Local: http://localhost:3000
# Production: your Vercel origin, e.g. https://calorie-tracker.vercel.app
CORS_ORIGIN="http://localhost:3000"

# Must be a long random string. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Photo extraction only (Groq or any OpenAI-compatible vision host).
# Chat does not use these keys — it uses GEMINI_API_KEY below.
# Leave blank to run without photo extract: that route then returns a clear 503.
#
#   Groq:    https://api.groq.com/openai/v1  qwen/qwen3.6-27b     AI_JSON_MODE=object
#   OpenAI:  https://api.openai.com/v1       gpt-4o-mini          AI_JSON_MODE=schema
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_JSON_MODE="schema"
AI_CHAT_MODEL=""

# Optional, and only sent when set — a provider that does not recognise it
# rejects the whole request. Applies to photo extraction alone; chat takes the
# provider's default, since the accepted levels differ per model ("none" is valid
# on Qwen and rejected by gpt-oss, which takes only low, medium or high).
#
# Set this for a model that reasons before answering, such as Groq's Qwen.
# Extraction asks a narrow question with the answer shape already pinned down, so
# thinking mostly costs latency and tokens: on a free Groq tier metered at 8,000
# tokens per minute, "none" took a short reply from 112 completion tokens to 2.
# Accepts: none, low, medium, high.
AI_REASONING_EFFORT=""

# Chat and PDF Deep Analyse. Photos stay on AI_* (Groq) so chat cannot
# exhaust the vision quota. A Gemini key from https://aistudio.google.com/apikey.
#
# A Gemini API key from https://aistudio.google.com/apikey. The default model
# is the current free-tier Flash; override if Google has renamed it.
#
# Current GA Flash. gemini-2.5-flash is retired for new keys.
# If 3.5 is busy the client tries 3.5-flash-lite, then 3.6-flash.
#
#   GEMINI_MODEL="gemini-3.5-flash"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
