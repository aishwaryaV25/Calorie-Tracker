# Local database. SQLite keeps setup to zero steps; see README for switching to Postgres.
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"

# Must be a long random string. Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Required for AI image extraction and the conversational chat interface.
# Leave blank to run the app without AI: those routes then return a clear 503.
#
# Any provider that speaks the OpenAI chat-completions API works. Set the three
# variables together — the base URL, a model that provider actually serves, and
# the JSON mode it supports.
#
#   OpenAI:  https://api.openai.com/v1     gpt-4o-mini            AI_JSON_MODE=schema
#   Groq:    https://api.groq.com/openai/v1  qwen/qwen3.6-27b     AI_JSON_MODE=object
#
# AI_JSON_MODE=schema asks the provider to enforce the response schema during
# decoding. Only OpenAI does that reliably; on Groq only the text-only gpt-oss
# models support it, so use "object" there and let the app validate the reply.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_JSON_MODE="schema"

# Optional, and only sent when set — a provider that does not recognise it
# rejects the whole request.
#
# Set this for a model that reasons before answering, such as Groq's Qwen. This
# app asks narrow questions with the answer shape already pinned down, so
# thinking mostly costs latency and tokens: on a free Groq tier metered at 8,000
# tokens per minute, "none" took a short reply from 112 completion tokens to 2.
# Accepts: none, low, medium, high.
AI_REASONING_EFFORT=""
